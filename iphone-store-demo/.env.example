# ============================================================
# iPhone Store (demo) — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real credentials.
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- PayOS (only needed when PAYMENT_MODE=real) ----
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ---- App ----
NEXT_PUBLIC_URL=http://localhost:3000

# ---- Email / SMTP ----
SMTP_USER=
SMTP_PASSWORD=
# Admin notification inbox (used by checkout emails)
ADMIN_EMAIL=admin@example.com

# ---- Cron ----
CRON_SECRET=

# ---- Testing ----
# real = PayOS checkout, mock = local /checkout/mock-payment page
PAYMENT_MODE=real
# Simulated gateway delay in milliseconds
MOCK_PAYMENT_DELAY_MS=1000
# Enable POST /api/test/* (seed, reset, create-order, auth-token)
ENABLE_TEST_API=false
# Rate limit for POST /api/checkout and GET /api/orders (0 = disabled)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
